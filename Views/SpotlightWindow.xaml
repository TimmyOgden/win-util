<Window x:Class="WinUtil.Views.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WinUtil command palette"
        Width="620"
        MinHeight="88"
        MaxHeight="680"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="{StaticResource FontSizeBody}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Deactivated="HandleDeactivated"
        SizeChanged="HandleWindowSizeChanged"
        PreviewKeyDown="HandlePreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <sys:Double x:Key="ActionResultsMaximumHeight">288</sys:Double>
    <sys:Double x:Key="SearchRowHeight">54</sys:Double>
    <sys:Double x:Key="WorkspaceEditorHeight">120</sys:Double>
    <Style x:Key="WorkspaceTextBox" TargetType="TextBox">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentMutedBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style x:Key="CommandResultItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ResultBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="Transparent"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ResultBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ResultBorder" Property="Background" Value="{StaticResource AccentMutedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="KeyHint" TargetType="Border">
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style x:Key="KeyHintText" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="ActionGlyph" TargetType="TextBlock">
      <Setter Property="Width" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Text" Value="&#xE8AB;" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Id}" Value="password">
          <Setter Property="Text" Value="&#xE72E;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="JSON">
          <Setter Property="Text" Value="&#xE943;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Encoding">
          <Setter Property="Text" Value="&#xE71B;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Case">
          <Setter Property="Text" Value="&#xE8D2;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Margin="12"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardCornerRadius}"
          Effect="{StaticResource ElevatedShadow}"
          SnapsToDevicePixels="True">
    <Grid>
    <StackPanel x:Name="PalettePanel" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border Height="{StaticResource SearchRowHeight}" Padding="16,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource IconFont}"
                     FontSize="17"
                     Foreground="{StaticResource AccentBrush}"
                     Text="&#xE721;" />
          <Grid Grid.Column="1">
            <TextBox x:Name="CommandTextBox"
                     Padding="0"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="{StaticResource AccentBrush}"
                     FontSize="17"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     SelectionBrush="{StaticResource AccentMutedBrush}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search tools" />
            <TextBlock VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="17"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Search tools and commands">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasQuery}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
            <Button x:Name="WorkspaceButton"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CompactSecondaryButton}"
                    Content="Workspace"
                    Click="HandleOpenWorkspace"
                    ToolTip="Run tools with your own input and copy the result" />
            <Border Style="{StaticResource KeyHint}" ToolTip="Escape closes Spotlight">
              <TextBlock Style="{StaticResource KeyHintText}" Text="Esc" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
      <Border Margin="16,0,16,8"
              Padding="10,8"
              Background="{StaticResource SurfaceRaisedBrush}"
              BorderBrush="{StaticResource ErrorBrush}"
              BorderThickness="2,0,0,0"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" />
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="6"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="12,4,12,8" Style="{StaticResource CaptionText}" Text="{Binding ResultsLabel}" />
            <ListBox x:Name="ActionResultsListBox"
                     Grid.Row="1"
                     MaxHeight="{StaticResource ActionResultsMaximumHeight}"
                     Padding="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     ItemsSource="{Binding MatchingActions}"
                     ItemContainerStyle="{StaticResource CommandResultItem}"
                     SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasMatches, Converter={StaticResource BooleanToVisibilityConverter}}"
                     SelectionChanged="HandleActionSelectionChanged"
                     MouseDoubleClick="HandleActionDoubleClick"
                     AutomationProperties.Name="Matching tools">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ActionGlyph}" ToolTip="{Binding Category}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold"
                                 Text="{Binding Title}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                      <TextBlock Margin="0,2,0,0"
                                 Style="{StaticResource CaptionText}"
                                 Text="{Binding Description}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="12,0,0,0" Tag="{Binding Id}" Click="HandleToggleFavorite"
                            AutomationProperties.Name="{Binding Title, StringFormat='Favorite {0}'}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CompactSecondaryButton}">
                          <Setter Property="Content" Value="Favorite" />
                          <Setter Property="ToolTip" Value="Add to favorites" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                              <Setter Property="Content" Value="Unfavorite" />
                              <Setter Property="ToolTip" Value="Remove from favorites" />
                              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Border Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource KeyHint}">
                      <Border.Visibility>
                        <Binding Path="IsSelected"
                                 RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                                 Converter="{StaticResource BooleanToVisibilityConverter}" />
                      </Border.Visibility>
                      <TextBlock Style="{StaticResource KeyHintText}" Text="Enter" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="NoResultsPanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,20">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasQuery}" Value="True" />
                        <Condition Binding="{Binding HasMatches}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No matching tools" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Center"
                         Style="{StaticResource CaptionText}"
                         Text="Try uuid, password, jwt, json, base64 or url." />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1"
                Padding="16,8"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CaptionText}" Text="Insert at cursor or replace selection" />
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="↑ ↓  Navigate" />
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
    <ScrollViewer x:Name="WorkspacePanel"
                  MaxHeight="620"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsWorkspaceOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Margin="16" DataContext="{Binding Workspace}">
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleText}" Text="Tool workspace" />
          <Button x:Name="BackToPaletteButton" Grid.Column="1" Margin="12,0,0,0"
                  Style="{StaticResource CompactSecondaryButton}" Content="Commands" Click="HandleCloseWorkspace"
                  ToolTip="Return to commands and clear the workspace" />
          <Button x:Name="CloseWorkspaceButton" Grid.Column="2" Margin="8,0,0,0"
                  Style="{StaticResource CompactSecondaryButton}" Content="Close" Click="HandleClosePalette"
                  ToolTip="Close Spotlight and clear the workspace (Esc)" />
        </Grid>
        <Label Padding="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" Target="{Binding ElementName=WorkspaceToolComboBox}" Content="Tool" />
        <ComboBox x:Name="WorkspaceToolComboBox"
                  Style="{StaticResource SettingsComboBox}"
                  ItemsSource="{Binding Tools}"
                  DisplayMemberPath="Title"
                  SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                  AutomationProperties.Name="Workspace tool" />
        <StackPanel x:Name="WorkspaceInputPanel" Margin="0,12,0,0"
                    Visibility="{Binding RequiresInput, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Label Padding="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" Target="{Binding ElementName=WorkspaceInputTextBox}" Content="Input" />
          <TextBox x:Name="WorkspaceInputTextBox"
                   Height="{StaticResource WorkspaceEditorHeight}"
                   Style="{StaticResource WorkspaceTextBox}"
                   Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Workspace input" />
        </StackPanel>
        <Grid Margin="0,12,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="WorkspaceRunButton" Style="{StaticResource PrimaryButton}" Content="{Binding RunLabel}"
                  IsEnabled="{Binding CanRun}" Click="HandleRunWorkspace" ToolTip="Run the selected tool (Ctrl+Enter)" />
          <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Ctrl+Enter to run" />
          <Button x:Name="WorkspaceCopyButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy result"
                  IsEnabled="{Binding CanCopy}" Click="HandleCopyWorkspace" />
        </Grid>
        <Border Margin="0,0,0,12" Padding="10,8" Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource ErrorBrush}" BorderThickness="2,0,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Label Padding="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" Target="{Binding ElementName=WorkspaceOutputTextBox}" Content="Output" />
        <TextBox x:Name="WorkspaceOutputTextBox" Height="{StaticResource WorkspaceEditorHeight}"
                 Style="{StaticResource WorkspaceTextBox}" IsReadOnly="True" IsUndoEnabled="False"
                 Text="{Binding OutputText, Mode=OneWay}" AutomationProperties.Name="Workspace output" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}" Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </Border>
</Window>
